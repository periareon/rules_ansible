load("@rules_req_compile//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")

# Solutions for every supported platform are compiled together from a single
# machine. Regenerate with:
#
#   bazel run //tools/requirements:requirements.update
#
# Pins are moved on purpose with `REQ_COMPILE_UPGRADE=<package>[,<package>]`
# or `REQ_COMPILE_UPGRADE=all` set on that command.
py_reqs_compiler(
    name = "requirements.update",
    requirements_in = "requirements.in",
    requirements_txts = {
        "requirements_linux_x86_64.txt": "manylinux_2_28_x86_64",
        "requirements_macos_aarch64.txt": "macosx_11_0_arm64",
        "requirements_windows_x86_64.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)
