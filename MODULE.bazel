"""rules_ansible"""

module(
    name = "rules_ansible",
    version = "0.1.0",
)

bazel_dep(name = "rules_venv", version = "0.37.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.64.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.7.1", dev_dependency = True)
bazel_dep(name = "rules_req_compile", version = "1.6.5", dev_dependency = True)

requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements", dev_dependency = True)
requirements.parse(
    name = "pip_deps",
    requirements_locks = {
        "//tools/requirements:requirements_linux_x86_64.txt": "linux_x86_64",
        "//tools/requirements:requirements_macos_aarch64.txt": "macos_aarch64",
        "//tools/requirements:requirements_windows_x86_64.txt": "windows_x86_64",
    },
)
use_repo(requirements, "pip_deps")

register_toolchains(
    "//ansible/toolchains:ansible_toolchain",
    "//tools/toolchains:black_toolchain",
    "//tools/toolchains:isort_toolchain",
    "//tools/toolchains:pylint_toolchain",
    "//tools/toolchains:mypy_toolchain",
    dev_dependency = True,
)

# Temporary compatibility patches for actions used by the development tools.
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//tools/patches:protobuf-auto-exec-groups.patch"],
    version = "33.4",
)
